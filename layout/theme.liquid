<!-- ——————————————— AUTHENTICITY & DOCUMENTATION ——————————————— -->
<section class="authenticity" id="authenticity" data-screen-label="05 Authenticity">
  <div class="container">
    <div class="reveal eyebrow" data-i18n="auth.eyebrow">— IV · No claims without proof</div>
    <h2 class="display reveal delay-1" data-i18n-html="auth.title">Four <em>quiet documents,</em><br/>folded into <em>every box.</em></h2>
    <p class="lede reveal delay-2" data-i18n="auth.sub">Every IRTH order arrives with a hand-numbered Certificate of Authenticity, a Certificate of Origin from source, an ISO-accredited Certificate of Analysis where applicable, and a QR code that links to the lab report — no claims without proof.</p>
    <div class="auth-grid reveal delay-2">
      <div class="auth-cell">
        <div class="num">01</div>
        <h4 data-i18n="auth.t1">Certificate of Origin</h4>
        <p data-i18n="auth.p1">Every Madinah date, every gram of Yemeni sidr honey, every Taif rose — sealed with a signed Certificate of Origin from the source farm or apiary.</p>
      </div>
      <div class="auth-cell">
        <div class="num">02</div>
        <h4 data-i18n="auth.t2">Certificate of Analysis</h4>
        <p data-i18n="auth.p2">Honey, dates, herbs and oils are batch-tested in an ISO 17025 accredited lab. The COA travels with the jar — never the other way around.</p>
      </div>
      <div class="auth-cell">
        <div class="num">03</div>
        <h4 data-i18n="auth.t3">QR Authenticity Code</h4>
        <p data-i18n="auth.p3">A unique QR pressed onto every box opens the batch record: source, lab report, packing date, and the artisan who closed the seal.</p>
      </div>
      <div class="auth-cell">
        <div class="num">04</div>
        <h4 data-i18n="auth.t4">Heirloom Packaging</h4>
        <p data-i18n="auth.p4">Charcoal-black presentation, hand-pressed 24-carat gold emblem, Madinah-green ribbon. Made to be reused, kept, remembered.</p>
      </div>
    </div>
  </div>
</section>


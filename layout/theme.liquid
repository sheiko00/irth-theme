<!-- ——————————————— CUSTOM ORDERS ——————————————— -->
<section class="custom" id="custom" data-screen-label="08 Custom Orders">
  <div class="container">
    <div class="custom-head">
      <div>
        <div class="reveal eyebrow" data-i18n="cu.eyebrow">— VII · Custom Orders</div>
        <h2 class="display reveal delay-1" data-i18n-html="cu.title">Tell us <em>who it is for.</em><br/>We will compose <em>the rest.</em></h2>
        <p class="lede reveal delay-2" data-i18n="cu.sub">For weddings, Ramadan, Eid, or a quiet personal gesture — we hand-assemble bespoke heritage boxes around a single intention. Send us a brief and we will reply within one working day.</p>
      </div>
    </div>

    <div class="custom-grid">
      <div class="custom-card reveal delay-1">
        <div class="custom-num">01</div>
        <h3 data-i18n="cu.s1t">Send a brief</h3>
        <p data-i18n="cu.s1p">Tell us the occasion, the recipient, your budget, and any pieces you have in mind. WhatsApp, email, or the form below — whichever is easiest.</p>
      </div>
      <div class="custom-card reveal delay-2">
        <div class="custom-num">02</div>
        <h3 data-i18n="cu.s2t">We compose a proposal</h3>
        <p data-i18n="cu.s2p">Within one working day you receive a styled mood-board with the proposed pieces, the dedication card mock-up, and the final EGP price.</p>
      </div>
      <div class="custom-card reveal delay-3">
        <div class="custom-num">03</div>
        <h3 data-i18n="cu.s3t">We hand-assemble &amp; deliver</h3>
        <p data-i18n="cu.s3p">Once approved, your gift is composed, sealed with a numbered Certificate of Authenticity, and delivered by white-glove courier anywhere in Egypt.</p>
      </div>
    </div>

    <form class="custom-form reveal delay-2" id="customForm" onsubmit="return false;">
      <div class="custom-form-grid">
        <label>
          <span data-i18n="cu.fn">Your name</span>
          <input type="text" name="name" required>
        </label>
        <label>
          <span data-i18n="cu.fp">Phone or WhatsApp</span>
          <input type="tel" name="phone" required>
        </label>
        <label>
          <span data-i18n="cu.fo">Occasion</span>
          <select name="occasion">
            <option data-i18n="cu.fo1">Wedding</option>
            <option data-i18n="cu.fo2">Ramadan</option>
            <option data-i18n="cu.fo3">Eid</option>
            <option data-i18n="cu.fo4">Corporate gifting</option>
            <option data-i18n="cu.fo5">Personal</option>
            <option data-i18n="cu.fo6">Other</option>
          </select>
        </label>
        <label>
          <span data-i18n="cu.fb">Budget (EGP)</span>
          <select name="budget">
            <option>2,000 – 5,000</option>
            <option>5,000 – 10,000</option>
            <option>10,000 – 25,000</option>
            <option>25,000+</option>
          </select>
        </label>
        <label class="full">
          <span data-i18n="cu.fm">Tell us a little about who it is for</span>
          <textarea name="brief" rows="3"></textarea>
        </label>
      </div>
      <button type="submit" class="cta" data-form-submit>
        <span data-i18n="cu.fcta">Send the brief</span><span class="arrow"></span>
      </button>
      <div class="custom-form-success" data-i18n="cu.fok" hidden>Thank you. We have your brief — expect a reply within one working day.</div>
    </form>
  </div>
</section>

